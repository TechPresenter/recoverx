{
  "name": "recoverx",
  "productName": "RecoverX",
  "version": "1.0.0",
  "description": "RecoverX — professional data recovery suite for Windows 10 and Windows 11.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Appsgain Technologies",
    "email": "info@appsgain.in",
    "url": "https://appsgain.in"
  },
  "homepage": "https://recoverx.snapkio.com/",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "clean": "rimraf out release .vite coverage",
    "package:store": "npm run icon && npm run build && node scripts/package-store.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "licensing:keys": "node scripts/generate-license-keys.mjs",
    "licensing:build": "vite build --config server.vite.config.ts",
    "licensing:server": "node dist/license-server/server.mjs",
    "licensing:admin": "node dist/license-server/admin.mjs",
    "licensing:php:test": "node server-php/scripts/test.mjs",
    "licensing:php:package": "node server-php/scripts/package.mjs",
    "website:build": "node website/build.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "i18next": "^26.3.6",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "lucide-react": "^1.27.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "rimraf": "^6.1.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
