{
  "//": "Electron main process, preload bridge, shared kernel, the vendor-side licence server (src/server) and build tooling. Runs on Node 24 (the runtime embedded in Electron 43, and the licence server's container image) — no DOM lib is available here on purpose, so accidental browser API usage in the main process is a compile error.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@server/*": ["src/server/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/server/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/unit/server/**/*.ts",
    "tests/e2e/**/*.ts",
    "electron.vite.config.ts",
    "server.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "prettier.config.mjs"
  ]
}
