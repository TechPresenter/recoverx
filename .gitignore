# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
out/
dist/
release/
.vite/

# Native build artifacts
native/**/target/
*.node

# Test / coverage output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
# Generated by `npm run icon` from scripts/generate-icon.mjs. Kept out of the
# repository because a committed binary cannot be reviewed in a diff. The Store
# box art (build/store) and the MSIX tile set (build/appx) are drawn by the same
# script from the same shapes.
build/icon.ico
build/icon.png
build/store/
build/appx/

# The licence signing key. Anyone holding it can mint a licence for any
# edition of this product, so it must never be committed.
license-signing-key.pem

.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
!.vscode/settings.json
!.vscode/extensions.json
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# Signing material — never commit
build/*.pfx
build/*.p12
build/*.key

# Claude Code local files (machine-specific paths, scheduler locks)
.claude/

# Never commit keys, databases or local secrets (licence server data, snapshots)
*.pem
*.db
*.db-wal
*.db-shm
secrets/
