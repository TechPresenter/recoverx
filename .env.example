# RecoverX — local development environment.
# Copy to `.env` and adjust. `.env` is git-ignored and is NEVER read in a
# packaged build: production configuration comes from electron-builder.yml and
# from user settings persisted in SQLite.

# Minimum severity written to the log files and to the in-app Logs screen.
# One of: error | warn | info | debug
RECOVERX_LOG_LEVEL=debug

# Open Chrome DevTools automatically when the main window is ready.
RECOVERX_OPEN_DEVTOOLS=false

# Override the user-data directory so a dev session cannot touch the settings
# database of an installed copy. Leave empty to use the Electron default
# (%APPDATA%/RecoverX).
RECOVERX_USER_DATA_DIR=

# Force the update feed used by electron-updater during manual QA.
RECOVERX_UPDATE_FEED_URL=
