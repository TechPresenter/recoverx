# RecoverX — npm configuration
#
# `fund` and `audit` noise is suppressed during install because the postinstall
# step (electron-builder install-app-deps) already produces a lot of output and
# the security audit is run explicitly in CI instead.
fund=false
audit=false

# Native modules (better-sqlite3) are compiled against the Electron ABI by the
# `postinstall` script, not by npm itself. Keeping `save-exact` off allows
# patch-level security updates of transitive dependencies.
save-exact=false

# Fail fast rather than silently resolving an incompatible peer tree. The
# dependency matrix in package.json is pinned to a set whose peer ranges were
# verified to intersect — do not relax this to --legacy-peer-deps:
#   vite 7.x        <- required by electron-vite 5.x (peer: ^5 || ^6 || ^7)
#   @vitejs/plugin-react 5.x <- v6 requires vite ^8
#   typescript 5.9.x <- required by typescript-eslint 8.x (peer: <6.1.0)
#   eslint 9.x      <- eslint-plugin-jsx-a11y 6.10.x caps at ^9
legacy-peer-deps=false
